{
  "name": "elibraryapp",
  "main": "./index.js",
  "version": "1.0.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "pnpm --filter @elibrary/web dev",
    "web:build": "pnpm --filter @elibrary/web build",
    "functions:build": "pnpm --filter elibrary-functions build",
    "functions:serve": "pnpm --filter elibrary-functions serve",
    "functions:deploy": "pnpm --filter elibrary-functions deploy",
    "typecheck": "tsc --noEmit && pnpm --filter @elibrary/web typecheck",
    "lint": "eslint . && pnpm --filter @elibrary/web lint"
  },
  "dependencies": {
    "@elibrary/theme": "workspace:*",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.4.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-device": "^57.0.0",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "^57.0.2",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "reactotron-react-native": "^5.1.18",
    "typescript": "~5.9.2"
  },
  "private": true
}
