    "@react-native-async-storage/async-storage": "2.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-device": "^57.0.0",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
